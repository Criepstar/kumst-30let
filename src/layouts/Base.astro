---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import { SITE, u } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** ohne Fußzeile – für Fragmente und die Admin-Oberfläche */
  bare?: boolean;
  noindex?: boolean;
}

const {
  title = '30 let / 30 Jahre KUMST',
  description = 'Kulturni dom KUMST v Žitari vasi je od leta 1996 most med ljudmi in jeziki – ob jubileju v slikah in besedah: arhivske fotografije in brošura. / Das Kulturhaus KUMST in Sittersdorf ist seit 1996 eine Brücke zwischen Menschen und Sprachen – zum Jubiläum in Bildern und Worten: Archivfotos und Broschüre.',
  bare = false,
  noindex = false,
} = Astro.props;

const siteOrigin = (Astro.site ?? new URL(SITE.url)).toString();
const canonical = new URL(Astro.url.pathname, siteOrigin).toString();
const ogImage = new URL(u('/brand/og.jpg'), siteOrigin).toString();
---

<!doctype html>
<html lang="sl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · KUMST</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#821E22" />
    <meta name="color-scheme" content="light" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KUMST – 30 let / 30 Jahre" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="sl_AT" />
    <meta property="og:locale:alternate" content="de_AT" />
    <meta name="twitter:card" content="summary_large_image" />

    <!--
      Statistik (Umami, selbst gehostet). In der Redaktion nicht mitzählen,
      damit die Zahlen nur den öffentlichen Teil abbilden.
    -->
    {
      !bare && !noindex && (
        <script
          is:inline
          defer
          src="https://stat.trta.at/script.js"
          data-website-id="1d5ffde4-45bb-417f-a26a-2049f77df697"
        />
      )
    }

    <slot name="head" />
  </head>
  <body class:list={['min-h-screen antialiased', bare && 'bg-cream']}>
    <a
      href="#main"
      class="label sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-wine focus:px-4 focus:py-2 focus:text-cream"
    >
      K vsebini / Zum Inhalt
    </a>

    <main id="main">
      <slot />
    </main>
    {!bare && <Footer />}

    <div id="lightbox-slot"></div>

    <script>
      import htmx from 'htmx.org';

      htmx.config.historyCacheSize = 0;
      htmx.config.refreshOnHistoryMiss = true;
      htmx.config.includeIndicatorStyles = false;

      // Direkt verlinktes Foto: die Lightbox steht im <main>, htmx tauscht aber
      // in #lightbox-slot. Einmal umhängen – sonst gäbe es nach dem ersten
      // Weiterblättern zwei Betrachter, und Tastatur wie Wischen würden den
      // alten, verdeckten treffen.
      {
        const slot = document.getElementById('lightbox-slot');
        const direct = document.getElementById('lightbox');
        if (slot && direct && !slot.contains(direct)) slot.appendChild(direct);
      }

      function closeLightbox() {
        const lb = document.getElementById('lightbox');
        if (!lb) return;
        const galleryUrl = lb.dataset.galleryUrl || '/';
        const slot = document.getElementById('lightbox-slot');
        if (slot) slot.innerHTML = '';
        document.body.classList.remove('overflow-hidden');

        if (document.querySelector('.thumb')) {
          // One-Pager: die Galerie steht schon im Dokument – nur die Adresse zurücksetzen
          history.pushState(null, '', galleryUrl);
        } else {
          // Direkt verlinkt oder neu geladen: zurück zur Startseite
          location.href = galleryUrl;
        }
      }

      document.addEventListener('keydown', (event) => {
        const lb = document.getElementById('lightbox');
        if (!lb) return;
        if (event.key === 'Escape') {
          event.preventDefault();
          closeLightbox();
        } else if (event.key === 'ArrowRight') {
          (lb.querySelector('[data-lb-next]') as HTMLElement | null)?.click();
        } else if (event.key === 'ArrowLeft') {
          (lb.querySelector('[data-lb-prev]') as HTMLElement | null)?.click();
        }
      });

      document.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        if (target.closest('[data-lb-close]')) {
          event.preventDefault();
          closeLightbox();
        }
      });

      // Wischen über das Foto blättert weiter. Ein Wisch zählt nicht als Klick –
      // so öffnet sich dabei nicht versehentlich die .jpg-Fassung in einem Tab.
      // Gezoomt wird die Seite selbst (Pinch, siehe `.lb-stage`); dann gehören
      // die Gesten dem Browser, und hier wird nicht geblättert.
      let swipeStartX = 0;
      let swipeStartY = 0;
      let swipeTracking = false;
      let swipeActive = false;
      let suppressClickUntil = 0;

      const pageZoomed = () => (window.visualViewport?.scale ?? 1) > 1.01;

      const resetSwipe = () => {
        swipeTracking = false;
        swipeActive = false;
      };

      document.addEventListener(
        'pointerdown',
        (event) => {
          const target = event.target as HTMLElement | null;
          if (!target?.closest('[data-lb-stage]')) return;
          if (event.pointerType === 'mouse' && event.button !== 0) return;
          if (pageZoomed()) return;
          swipeStartX = event.clientX;
          swipeStartY = event.clientY;
          swipeTracking = true;
          swipeActive = false;
        },
        true,
      );

      document.addEventListener(
        'pointermove',
        (event) => {
          if (!swipeTracking) return;
          const dx = event.clientX - swipeStartX;
          const dy = event.clientY - swipeStartY;
          if (!swipeActive && Math.abs(dx) > 12 && Math.abs(dx) > Math.abs(dy)) {
            swipeActive = true;
          }
        },
        true,
      );

      document.addEventListener(
        'pointerup',
        (event) => {
          if (!swipeTracking) return;
          const dx = event.clientX - swipeStartX;
          const dy = event.clientY - swipeStartY;
          const wasSwipe = swipeActive;
          resetSwipe();
          const flipped = wasSwipe && Math.abs(dx) >= 45 && Math.abs(dx) >= Math.abs(dy);
          if (flipped) {
            const selector = dx < 0 ? '[data-lb-next]' : '[data-lb-prev]';
            (document.querySelector(selector) as HTMLElement | null)?.click();
          }
          // Erst nach dem Weiterblättern sperren – sonst schluckt der Filter
          // genau den ausgelösten Klick. Der Klick, den der Browser nach dem
          // Wischen selbst noch schickt, wird dadurch verworfen.
          if (wasSwipe) suppressClickUntil = Date.now() + 350;
        },
        true,
      );

      document.addEventListener('pointercancel', resetSwipe, true);

      // Der Klick direkt nach einem Wisch wird geschluckt
      document.addEventListener(
        'click',
        (event) => {
          if (Date.now() >= suppressClickUntil) return;
          event.preventDefault();
          event.stopPropagation();
        },
        true,
      );

      // Kein natives Bild-Ziehen im Betrachter
      document.addEventListener('dragstart', (event) => {
        const target = event.target as HTMLElement | null;
        if (target?.closest('[data-lb-stage] img')) event.preventDefault();
      });

      document.body.addEventListener('htmx:afterSwap', (event) => {
        const detail = (event as CustomEvent).detail;
        if (detail?.target?.id !== 'lightbox-slot') return;
        const open = !!document.getElementById('lightbox');
        document.body.classList.toggle('overflow-hidden', open);
      });

      // Fehler beim Nachladen freundlich abfangen
      document.body.addEventListener('htmx:responseError', () => {
        const slot = document.getElementById('lightbox-slot');
        if (slot) slot.innerHTML = '';
        document.body.classList.remove('overflow-hidden');
      });
    </script>
  </body>
</html>
