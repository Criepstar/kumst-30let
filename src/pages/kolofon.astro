---
import Base from '../layouts/Base.astro';
import BiText from '../components/BiText.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { KOLOFON, GALLERY } from '../lib/content';
import { SITE, u } from '../lib/site';
---

<Base title="Kolofon / Impressum" description={KOLOFON.siteNoteDe}>
  <section class="border-b border-wine/15 bg-cream-deep/40">
    <div class="shell py-12 sm:py-16">
      <SectionHeading label={KOLOFON.label} sl={KOLOFON.heading.sl} de={KOLOFON.heading.de} size="lg" />
    </div>
  </section>

  <section class="section">
    <div class="shell grid gap-14 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:gap-20">
      <div>
        <dl class="divide-y divide-wine/15 border-t border-wine/15">
          {
            KOLOFON.rows.map((row) => (
              <div class="grid gap-2 py-5 sm:grid-cols-[minmax(0,0.4fr)_minmax(0,0.6fr)] sm:gap-6">
                <dt class="label pt-1 text-sage-deep">
                  {row.k.sl} <span class="text-wine/35">/</span> {row.k.de}
                </dt>
                <dd class="text-[0.9375rem] leading-relaxed text-ink">{row.v}</dd>
              </div>
            ))
          }
        </dl>

        <div class="mt-10 max-w-xl">
          <BiText sl={KOLOFON.siteNoteSl} de={KOLOFON.siteNoteDe} size="sm" />
          <p class="mt-4 text-[0.875rem] leading-relaxed text-ink/70">
            Spletna stran in brošura sta nastali ob tridesetletnici kulturnega doma.
            Vse fotografije izvirajo iz arhiva društva TRTA.
            <span lang="de" class="mt-1 block text-wine/80">
              Website und Broschüre sind zum dreißigjährigen Bestehen des Kulturhauses
              entstanden. Alle Fotografien stammen aus dem Archiv des Vereins TRTA.
            </span>
          </p>
        </div>
      </div>

      <aside class="space-y-8">
        <div class="border border-wine/25 bg-wine px-7 py-8 text-cream sm:px-9">
          <p class="label text-sage">{KOLOFON.contact.sl} / {KOLOFON.contact.de}</p>
          <address class="mt-5 space-y-1 text-[0.9375rem] leading-relaxed not-italic">
            <p class="font-semibold">{SITE.org.nameSl}</p>
            <p lang="de" class="text-rose">{SITE.org.nameDe}</p>
            <p class="pt-3">{SITE.org.street}</p>
            <p>{SITE.org.city}</p>
            <p>{SITE.org.country}</p>
            <p class="pt-3">
              <a class="link-magenta" href={`mailto:${SITE.org.mail}`}>{SITE.org.mail}</a>
            </p>
            <p>
              <a class="link-magenta" href={`https://${SITE.org.web}`} rel="noopener">{SITE.org.web}</a>
            </p>
          </address>
        </div>

        <div class="border border-wine/25 bg-wine px-7 py-8 text-cream">
          <p class="label text-sage">Financiranje / Förderung</p>
          <p class="mt-4 text-[0.875rem] leading-relaxed text-cream/90" lang="sl">{KOLOFON.fundingSl}</p>
          <p class="mt-1 text-[0.875rem] leading-relaxed text-cream/60" lang="de">{KOLOFON.funding}</p>
          <img
            src={u('/brand/foerdergeber.png')}
            alt="Logos der Fördergeber: Bundeskanzleramt, Druckerei Mohorjeva Hermagoras, Grafik Mario Franc Korpitsch"
            width="1575"
            height="832"
            loading="lazy"
            decoding="async"
            class="mt-7 h-auto w-full"
          />
        </div>

        <div class="border border-wine/20 px-7 py-8">
          <p class="label text-sage-deep">Brošura / Broschüre</p>
          <p class="mt-4 text-[0.875rem] leading-relaxed text-ink/80">
            {SITE.brochure.sizeLabel}
          </p>
          <a class="btn btn-ghost mt-5" href={u(SITE.brochure.file)} download>
            Prenesi / Herunterladen <span aria-hidden="true">↓</span>
          </a>
        </div>
      </aside>
    </div>

    <div class="shell mt-16">
      <a class="btn btn-ghost" href={u('/galerija')}>
        {GALLERY.showAll.sl} / {GALLERY.showAll.de} <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Base>
