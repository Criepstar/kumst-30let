---
import Base from '../layouts/Base.astro';
import BiText from '../components/BiText.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import { DOWNLOAD, GALLERY, HERO } from '../lib/content';
import { SITE, u } from '../lib/site';
import { listPhotos } from '../lib/gallery';

const photos = await listPhotos(true);
---

<Base>
  <!-- ------------------------------------------------------------ Hero -->
  <!-- Die Grafik ist die Cover-Illustration der Broschüre: Sie enthält den
       Ziegeltitel «30 let – 30 Jahre» und den Claim «Kulturni most /
       Kulturbrücke». Mobil steht sie als Poster über dem Text, ab lg links
       daneben. Die Überschrift über dem Vorwort ist der sichtbare H1
       (Slowenisch groß, Deutsch darunter). -->
  <section class="relative overflow-hidden bg-wine text-cream">
    <div class="pointer-events-none absolute inset-0 opacity-[0.06] " aria-hidden="true">
    </div>

    <div
      class="shell relative flex flex-col items-center pt-8 pb-9 text-center lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,0.95fr)] lg:items-center lg:gap-x-14 lg:pt-10 lg:pb-12 lg:text-left xl:gap-x-20"
    >
      <img
        src={u('/brand/kumst-hero.svg')}
        alt="Naslovnica brošure: hiša KUMST iz zidakov in most / Broschüren-Cover: Kulturhaus KUMST aus Ziegeln und eine Brücke"
        width="967"
        height="1064"
        class="h-auto w-auto object-contain sm:max-h-[52vh] lg:col-start-1 lg:max-h-[56vh] lg:justify-self-center"
        fetchpriority="high"
      />

      <!-- Text und Buttons: mobil unter der Grafik, ab lg rechts daneben -->
      <div class="mt-6 max-w-2xl sm:mt-7 lg:col-start-2 lg:row-start-1 lg:mt-0 lg:max-w-xl lg:self-center">
        <!-- Sichtbar nur ab lg (Text neben dem Poster); mobil trägt das Poster den Titel, der H1 bleibt für Screenreader im Markup. -->
        <h1 class="sr-only text-balance lg:not-sr-only">
          <span lang="sl" class="block text-[clamp(1.625rem,3vw,2.5rem)] text-cream">
            {HERO.heading.sl}
          </span>{' '}
          <span lang="de" class="mt-1.5 block text-[clamp(1.0625rem,1.7vw,1.4375rem)] text-rose">
            {HERO.heading.de}
          </span>
        </h1>

        <BiText sl={HERO.leadSl} de={HERO.leadDe} tone="dark" size="lead" class="lg:mt-5 xl:mt-6" />

        <div class="mt-6 flex flex-wrap items-center justify-center gap-3 sm:mt-7 lg:mt-8 lg:justify-start">
          <a class="btn w-64 text-center btn-cream on-dark" href="#galerija">
            {HERO.ctaGallery.sl} / {HERO.ctaGallery.de}
            <span aria-hidden="true">↓</span>
          </a>
          <a
            class="btn on-dark text-center w-64 border-cream/60 text-cream hover:bg-cream hover:text-wine inline-flex"
            href={u(SITE.brochure.file)}
            target="_blank"
            rel="noopener"
          >
            {HERO.ctaBrochure.sl} / {HERO.ctaBrochure.de}
          </a>
        </div>
      </div>
    </div>

    <div class="relative h-1.5 w-full bg-sage" aria-hidden="true"></div>
  </section>

  <!-- ---------------------------------------------------------- Galerie -->
  <section id="galerija" class="scroll-mt-2 pt-12 pb-16 sm:pt-16 sm:pb-20">
    <div class="shell">
      <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
        <SectionHeading sl={GALLERY.heading.sl} de={GALLERY.heading.de} />
        <p class="label pb-1 text-ink/60">
          {GALLERY.countSl(photos.length)} <span class="text-wine/35">/</span>
          {GALLERY.countDe(photos.length)}
        </p>
      </div>

      <BiText sl={GALLERY.introSl} de={GALLERY.introDe} class="mt-6 max-w-2xl" />


      <div class="mt-10 sm:mt-12">
        {
          photos.length > 0 ? (
            <PhotoGrid photos={photos} />
          ) : (
            <div class="border border-dashed border-wine/30 px-6 py-20 text-center">
              <p class="text-ink/80" lang="sl">
                {GALLERY.emptySl}
              </p>
              <p class="mt-2 text-wine/80" lang="de">
                {GALLERY.emptyDe}
              </p>
            </div>
          )
        }
      </div>

      <div class="mt-2 flex items-center justify-between gap-4 border-t border-wine/15 pt-4">
        <p class="label text-ink/45">{GALLERY.archive}</p>
        <p class="label text-ink/40 tabular-nums">1996 – 2026</p>
      </div>
    </div>
  </section>

  <!-- ------------------------------------- Broschüre (Download-Hinweis) -->
  <section id="brosura" class="scroll-mt-2 border-t border-wine/15 bg-cream-deep/50">
    <div class="shell flex flex-col gap-6 py-10 sm:flex-row sm:items-center sm:justify-between sm:gap-10 sm:py-12">
      <div>
        <SectionHeading sl={DOWNLOAD.heading.sl} de={DOWNLOAD.heading.de} />
        <p class="mt-5 max-w-xl text-[0.9375rem] leading-relaxed text-ink/85" lang="sl">
          {DOWNLOAD.lineSl}
        </p>
        <p class="max-w-xl text-[0.9375rem] leading-relaxed text-wine/85" lang="de">
          {DOWNLOAD.lineDe}
        </p>
        <div class="mt-5 flex flex-wrap items-center gap-3">
            <a class="btn btn-wine" href={u(SITE.brochure.file)} target="_blank" rel="noopener">
            {DOWNLOAD.cta.sl} / {DOWNLOAD.cta.de}
            <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
