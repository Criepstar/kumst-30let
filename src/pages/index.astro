---
import Base from '../layouts/Base.astro';
import BiText from '../components/BiText.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import { DOWNLOAD, GALLERY, HERO } from '../lib/content';
import { SITE, u } from '../lib/site';
import { listPhotos } from '../lib/gallery';

const photos = await listPhotos(true);
---

<Base>
  <!-- ------------------------------------------------------------ Hero -->
  <section class="relative overflow-hidden bg-wine text-cream">
    <div class="pointer-events-none absolute inset-0 opacity-[0.06] bricks-cream" aria-hidden="true">
    </div>

    <div
      class="shell relative grid items-center gap-7 pt-8 pb-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.92fr)] lg:gap-14 lg:pt-12 lg:pb-14"
    >
      <div class="relative z-10">
        <div class="flex items-center gap-3">
          <span class="block h-px w-10 bg-sage" aria-hidden="true"></span>
          <p class="label text-sage">{HERO.years}</p>
        </div>

        <h1 class="mt-4 text-cream lg:mt-5">
          <span class="block text-[clamp(2.5rem,7.2vw,5rem)] leading-[0.84]">{HERO.titleTop}</span>
          <span
            class="mt-1 block text-[clamp(2.5rem,7.2vw,5rem)] leading-[0.84] text-transparent"
            style="-webkit-text-stroke: 1.5px var(--color-cream);"
            lang="de">{HERO.titleBottom}</span
          >
        </h1>



        <BiText sl={HERO.leadSl} de={HERO.leadDe} tone="dark" size="lead" class="mt-5 max-w-xl lg:mt-6" />

        <div class="mt-7 flex flex-wrap items-center gap-3 lg:mt-8">
          <a class="btn btn-cream" href="#galerija">
            {HERO.ctaGallery.sl} / {HERO.ctaGallery.de}
            <span aria-hidden="true">↓</span>
          </a>
          <a
            class="btn hidden border-cream/60 text-cream hover:bg-cream hover:text-wine sm:inline-flex"
            href={u(SITE.brochure.file)}
            target="_blank"
            rel="noopener"
          >
            {HERO.ctaBrochure.sl} / {HERO.ctaBrochure.de}
          </a>
        </div>
      </div>

      <div class="relative">
        <img
          src={u('/brand/kumst-hero.svg')}
          alt="Ilustracija kulturnega doma KUMST / Illustration des Kulturhauses KUMST"
          width="590"
          height="500"
          class="mx-auto h-auto w-full max-h-[32vh] object-contain sm:max-h-[42vh] lg:max-h-[52vh]"
          fetchpriority="high"
        />
      </div>
    </div>

    <div class="relative h-1.5 w-full bg-sage" aria-hidden="true"></div>
  </section>

  <!-- ---------------------------------------------------------- Galerie -->
  <section id="galerija" class="scroll-mt-2 pt-12 pb-16 sm:pt-16 sm:pb-20">
    <div class="shell">
      <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
        <SectionHeading label={GALLERY.label} sl={GALLERY.heading.sl} de={GALLERY.heading.de} />
        <p class="label pb-1 text-ink/60">
          {GALLERY.countSl(photos.length)} <span class="text-wine/35">/</span>
          {GALLERY.countDe(photos.length)}
        </p>
      </div>

      <BiText sl={GALLERY.introSl} de={GALLERY.introDe} class="mt-6 max-w-2xl" />


      <div class="mt-10 sm:mt-12">
        {
          photos.length > 0 ? (
            <PhotoGrid photos={photos} />
          ) : (
            <div class="border border-dashed border-wine/30 px-6 py-20 text-center">
              <p class="text-ink/80" lang="sl">
                {GALLERY.emptySl}
              </p>
              <p class="mt-2 text-wine/80" lang="de">
                {GALLERY.emptyDe}
              </p>
            </div>
          )
        }
      </div>

      <div class="mt-2 flex items-center justify-between gap-4 border-t border-wine/15 pt-4">
        <p class="label text-ink/45">{GALLERY.archive}</p>
        <p class="label text-ink/40">1907 - 2026</p>
      </div>
    </div>
  </section>

  <!-- ------------------------------------- Broschüre (Download-Hinweis) -->
  <section id="brosura" class="scroll-mt-2 border-t border-wine/15 bg-cream-deep/50">
    <div class="shell flex flex-col gap-6 py-10 sm:flex-row sm:items-center sm:justify-between sm:gap-10 sm:py-12">
      <div>
        <h2 class="text-[clamp(1.5rem,2.8vw,2.125rem)] text-ink">
          {DOWNLOAD.heading.sl}
          <span lang="de" class="mt-0.5 block text-wine">{DOWNLOAD.heading.de}</span>
        </h2>
        <p class="mt-3 max-w-xl text-[0.9375rem] leading-relaxed text-ink/85" lang="sl">
          {DOWNLOAD.lineSl}
        </p>
        <p class="max-w-xl text-[0.9375rem] leading-relaxed text-wine/85" lang="de">
          {DOWNLOAD.lineDe}
        </p>
        <div class="mt-5 flex flex-wrap items-center gap-3">
            <a class="btn btn-wine" href={u(SITE.brochure.file)} target="_blank" rel="noopener">
            {DOWNLOAD.cta.sl} / {DOWNLOAD.cta.de}
            <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
