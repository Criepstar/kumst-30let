---
import { FOOTER, KOLOFON } from '../lib/content';
import { SITE, u } from '../lib/site';

const year = new Date().getFullYear();
---

<!--
  Kolofon/Impressum: ein roter Streifen mit klarer Ordnung.

  Eine Überschrift über die ganze Breite, darunter eine Haarlinie. Ab md zwei
  Spalten, getrennt durch eine senkrechte Haarlinie (mobil wird daraus eine
  waagrechte): links der Verein mit Kontakt, rechts die Förderung mit der
  Wortmarke des Bundeskanzleramts, darunter – durch eine Haarlinie getrennt –
  das Zeichen des Grafikers. Darunter die ruhige Fußzeile mit dem Copyright.
-->
<footer id="kolofon" class="bg-wine text-cream">
  <!-- Grüner Streifen wie unter dem Hero: trennt Galerie und Fußzeile. -->
  <div class="h-1.5 w-full bg-sage" aria-hidden="true"></div>

  <div class="shell py-11 sm:py-12 lg:py-14">
    <h2 class="label border-b border-cream/25 pb-2.5 text-cream/75">
      Kolofon / Impressum
    </h2>

    <div
      class="mt-6 grid gap-y-6 md:grid-cols-[1.2fr_1fr] md:gap-y-0 lg:mt-7"
    >
      <!-- Verein und Kontakt; die E-Mail sitzt am unteren Rand der Spalte,
           damit sie sich mit dem Kolofon rechts die Waage hält. -->
      <div class="md:flex md:flex-col md:justify-between">
        <div>
          <p class="text-[1.1875rem] leading-[1.3] font-semibold text-cream">
            {SITE.org.nameSl}
          </p>
          <p lang="de" class="text-[0.9375rem] leading-[1.4] text-rose">{SITE.org.nameDe}</p>

          <address class="mt-4 text-[0.9375rem] leading-relaxed text-cream/75 not-italic">
            {SITE.org.street}<br />
            {SITE.org.city}<br />
            {SITE.org.country}
          </address>
        </div>

        <p class="mt-4 md:mt-8">
          <a
            class="on-dark text-[0.9375rem] font-semibold underline decoration-cream/30 underline-offset-4 transition-colors hover:decoration-cream"
            href={`mailto:${SITE.org.mail}`}>{SITE.org.mail}</a
          >
        </p>
      </div>

      <!-- Förderung, Fördergeberin und die Zeichen der Gestaltung -->
      <div
        class="border-t border-cream/20 pt-6 md:border-t-0 md:border-l md:pt-0 md:pl-8 lg:pl-14"
      >
        <p
          lang="sl"
          class="text-[0.875rem] leading-[1.5] font-semibold text-cream xl:text-[0.9375rem]"
        >
          {KOLOFON.fundingSl}
        </p>
        <p lang="de" class="mt-1 text-[0.8125rem] leading-[1.5] text-rose xl:mt-1.5">
          {KOLOFON.funding}
        </p>
        <img
          src={u('/brand/bundeskanzleramt.png')}
          alt="Bundeskanzleramt Österreich"
          width="1248"
          height="92"
          loading="lazy"
          decoding="async"
          class="mt-4 block h-[1.0625rem] w-auto sm:h-[1.125rem] md:mt-3 md:h-[1.125rem] lg:mt-4 lg:h-5 xl:mt-6 xl:h-[1.375rem]"
        />

        <!--
          Haarlinie zwischen Fördergeberin und Gestaltung; darunter das Zeichen
          des Grafikers (führt auf mariofranc.at).
        -->
        <div class="mt-6 border-t border-cream/25 pt-5 md:mt-7 xl:mt-9">
          <a
            class="on-dark grid grid-cols-[3.5rem_minmax(0,1fr)] items-center gap-x-3 text-cream/70 transition-colors hover:text-cream"
            href="https://mariofranc.at/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Grafik: Mario Franc Korpitsch – mariofranc.at"
          >
            <img
              src={u('/brand/mario-franc.svg')}
              alt=""
              width="428"
              height="567"
              loading="lazy"
              decoding="async"
              class="w-10 justify-self-start lg:w-11"
            />
            <span class="text-[0.8125rem] leading-snug">
              Oblikovanje / Design
              <b class="block text-[0.875rem] font-semibold text-cream">Mario Franc Korpitsch</b>
            </span>
          </a>
        </div>
      </div>
    </div>

    <!-- Fußzeile -->
    <div
      class="mt-8 flex flex-wrap justify-between gap-x-6 gap-y-1.5 border-t border-cream/20 pt-3.5 lg:mt-10"
    >
      <p class="label text-cream/80">© {year} SPD Trta</p>
      <p class="text-[0.8125rem] text-cream/75">{FOOTER.taglineSl}</p>
    </div>
  </div>
</footer>
