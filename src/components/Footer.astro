---
import { KOLOFON } from '../lib/content';
import { SITE, u } from '../lib/site';

const year = new Date().getFullYear();
---

<!--
  Kolofon/Impressum: ein einziger roter Streifen. Kontakt, Förderhinweis,
  Fördergeber-Logos und Copyright fließen ohne Kästen und Trennlinien
  ineinander – kein separates beiges Kontaktband mehr.
-->
<footer id="kolofon" class="bg-wine text-cream">
  <div class="shell py-10 sm:py-12 lg:py-14">
    <div
      class="flex flex-col gap-9 text-[0.875rem] leading-relaxed sm:text-[0.9375rem] lg:flex-row lg:items-start lg:justify-between lg:gap-16"
    >
      <!-- Kontakt -->
      <address class="not-italic">
        <p class="font-semibold">{SITE.org.nameSl}</p>
        <p lang="de" class="text-cream/70">{SITE.org.nameDe}</p>
        <p class="mt-3 text-cream/70">
          {SITE.org.street}<br />
          {SITE.org.city}<br />
          {SITE.org.country}
        </p>
        <p class="mt-3">
          <a
            class="underline decoration-cream/40 underline-offset-[0.25em] transition-colors hover:decoration-cream"
            href={`mailto:${SITE.org.mail}`}>{SITE.org.mail}</a
          >
        </p>
      </address>

      <!-- Förderung, Fördergeber, Copyright -->
      <div class="max-w-sm lg:shrink-0">
        <p class="text-[0.8125rem] leading-relaxed text-cream/90" lang="sl">{KOLOFON.fundingSl}</p>
        <p class="mt-1 text-[0.8125rem] leading-relaxed text-cream/60" lang="de">{KOLOFON.funding}</p>
        <img
          src={u('/brand/foerdergeber.png')}
          alt="Logos der Fördergeber: Bundeskanzleramt, Druckerei Mohorjeva Hermagoras, Grafik Mario Franc Korpitsch"
          width="1575"
          height="832"
          loading="lazy"
          decoding="async"
          class="mt-5 h-auto w-56 sm:w-72"
        />
        <p class="label mt-5 text-cream/45">© {year} SPD Trta</p>
      </div>
    </div>
  </div>
</footer>
