---
import { NAV } from '../lib/content';
import { u } from '../lib/site';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => !href.startsWith('/#') && path === u(href);
---

<header class="sticky top-0 z-40 border-b border-wine/20 bg-cream/90 backdrop-blur-sm">
  <div class="shell flex flex-col gap-1.5 py-2.5 sm:flex-row sm:items-center sm:justify-between sm:gap-6 sm:py-3.5">
    <a href={u('/')} class="group flex shrink-0 items-baseline gap-3" aria-label="KUMST – 30 let / 30 Jahre">
      <span class="font-display text-[1.375rem] leading-none font-black tracking-[-0.02em] text-wine uppercase">
        KUMST
      </span>
      <span class="label hidden text-ink/70 transition-colors group-hover:text-magenta sm:inline">
        30 let&nbsp;/&nbsp;Jahre
      </span>
      <span class="label text-sage-deep sm:hidden">30 let / Jahre</span>
    </a>

    <nav aria-label="Glavna navigacija / Hauptnavigation" class="-mx-1 overflow-x-auto no-scrollbar">
      <ul class="flex items-center gap-0.5 sm:gap-2">
        {
          NAV.map((item) => (
            <li>
              <a
                href={u(item.href)}
                class:list={[
                  'label group relative block px-2 py-1.5 whitespace-nowrap transition-colors sm:px-3 sm:py-2',
                  isActive(item.href) ? 'text-magenta' : 'text-ink hover:text-wine',
                ]}
              >
                <span lang="sl">{item.label.sl}</span>
                <span class="mx-1 hidden text-wine/35 md:inline">/</span>
                <span lang="de" class="hidden text-wine/85 group-hover:text-magenta md:inline">
                  {item.label.de}
                </span>
                <span
                  class:list={[
                    'absolute inset-x-2 -bottom-px h-px bg-magenta transition-transform duration-300 sm:inset-x-3',
                    isActive(item.href) ? 'scale-x-100' : 'scale-x-0 group-hover:scale-x-100',
                  ]}
                />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
