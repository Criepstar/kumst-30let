---
import type { Photo } from '../lib/gallery';
import { mediaUrl, u } from '../lib/site';

interface Props {
  photo: Photo;
  prev?: Photo;
  next?: Photo;
  index: number;
  total: number;
  galleryUrl: string;
}

const { photo, prev, next, index, total, galleryUrl } = Astro.props;
const caption = photo.captionSl || photo.captionDe;
const photoHref = (id: string) => u(`/galerija/foto/${id}`);

const arrowClass =
  'pointer-events-auto inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-cream/30 text-cream/85 transition-colors hover:border-cream hover:bg-cream hover:text-wine sm:absolute sm:top-1/2 sm:h-12 sm:w-12 sm:-translate-y-1/2';
const iconClass = 'h-5 w-5';
---

<div
  id="lightbox"
  class="fixed inset-0 z-50 bg-wine-deep text-cream"
  data-gallery-url={galleryUrl}
  role="dialog"
  aria-modal="true"
  aria-label={`Fotografija ${index + 1} od ${total} / Foto ${index + 1} von ${total}`}
>
  <div class="pointer-events-none relative flex h-full flex-col">
    <!-- Kopfzeile: Zähler und schließen -->
    <div
      class="pointer-events-auto flex shrink-0 items-center justify-between gap-3 px-3 py-2.5 sm:px-6 sm:py-3"
    >
      <p class="label whitespace-nowrap text-cream/70">
        {index + 1} <span class="text-cream/35">/</span> {total}
      </p>

      <a
        class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-cream/30 text-cream/80 transition-colors hover:border-cream hover:bg-cream hover:text-wine"
        href={galleryUrl}
        data-lb-close
        aria-label="Zapri / Schließen"
      >
        <svg
          class={iconClass}
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          aria-hidden="true"><path d="M6.5 6.5l11 11M17.5 6.5l-11 11"></path></svg
        >
      </a>
    </div>

    <!--
      Bühne: ab sm stehen die Pfeile fest am linken und rechten Rand, damit sie
      beim Blättern nicht wandern. Mobil rutschen sie unter das Foto. Wischen
      über das Bild blättert ebenfalls weiter.
    -->
    <div
      class="pointer-events-none relative flex min-h-0 flex-1 flex-wrap touch-none select-none content-center items-center justify-center gap-x-6 gap-y-4 px-3 pb-5 sm:flex-nowrap sm:px-6 sm:pb-5"
      data-lb-stage
    >
      {
        prev && (
          <a
            class={`${arrowClass} order-2 sm:left-4 lg:left-8`}
            href={photoHref(prev.id)}
            hx-get={photoHref(prev.id)}
            hx-target="#lightbox-slot"
            hx-swap="innerHTML"
            hx-push-url="true"
            data-lb-prev
            aria-label="Prejšnja fotografija / Vorheriges Foto"
          >
            <svg
              class={iconClass}
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M14.5 5.5L8 12l6.5 6.5" />
            </svg>
          </a>
        )
      }

      <div
        class="pointer-events-auto order-1 flex w-full min-w-0 basis-full flex-col items-center justify-center sm:order-none sm:w-auto sm:basis-auto sm:px-20 lg:px-24"
      >
        <img
          src={mediaUrl(photo.id, 'full')}
          alt={caption || 'Arhivska fotografija / Archivfoto des Vereins Trta'}
          width={photo.width}
          height={photo.height}
          draggable="false"
          class="max-h-[calc(100svh-12rem)] w-auto max-w-full object-contain shadow-[0_30px_80px_-30px_rgba(0,0,0,0.8)] sm:max-h-[calc(100svh-9.5rem)]"
        />

        <div class="mt-4 max-w-2xl text-center sm:mt-5">
          {
            photo.captionSl && (
              <p lang="sl" class="text-[0.875rem] leading-snug text-cream sm:text-[0.9375rem]">
                {photo.captionSl}
              </p>
            )
          }
          {
            photo.captionDe && (
              <p lang="de" class="mt-1 text-[0.875rem] leading-snug text-rose sm:text-[0.9375rem]">
                {photo.captionDe}
              </p>
            )
          }
          {
            !caption && (
              <p class="text-[0.8125rem] text-cream/60">
                Iz arhiva SPD Trta <span class="text-cream/30">/</span> Aus dem Archiv des Vereins Trta
              </p>
            )
          }
        </div>
      </div>

      {
        next && (
          <a
            class={`${arrowClass} order-3 sm:right-4 lg:right-8`}
            href={photoHref(next.id)}
            hx-get={photoHref(next.id)}
            hx-target="#lightbox-slot"
            hx-swap="innerHTML"
            hx-push-url="true"
            data-lb-next
            aria-label="Naslednja fotografija / Nächstes Foto"
          >
            <svg
              class={iconClass}
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M9.5 5.5L16 12l-6.5 6.5" />
            </svg>
          </a>
        )
      }
    </div>
  </div>
</div>
