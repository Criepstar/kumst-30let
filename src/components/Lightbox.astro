---
import type { Photo } from '../lib/gallery';
import { GALLERY } from '../lib/content';
import { mediaUrl, photoFileUrl, u } from '../lib/site';

interface Props {
  photo: Photo;
  prev?: Photo;
  next?: Photo;
  index: number;
  total: number;
  galleryUrl: string;
}

const { photo, prev, next, index, total, galleryUrl } = Astro.props;
const caption = photo.captionSl || photo.captionDe;
const photoHref = (id: string) => u(`/galerija/foto/${id}`);
const arrowClass =
  'pointer-events-auto absolute top-1/2 z-10 inline-flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-cream/30 bg-wine-deep/55 text-cream/90 backdrop-blur-[2px] transition-colors hover:border-cream hover:bg-cream hover:text-wine sm:static sm:h-12 sm:w-12 sm:shrink-0 sm:translate-y-0 sm:self-center sm:bg-transparent';
---

<div
  id="lightbox"
  class="fixed inset-0 z-50 bg-wine-deep text-cream"
  data-gallery-url={galleryUrl}
  role="dialog"
  aria-modal="true"
  aria-label={`Fotografija ${index + 1} od ${total} / Foto ${index + 1} von ${total}`}
>
  <div class="absolute inset-0" data-lb-close aria-hidden="true"></div>

  <div class="pointer-events-none relative flex h-full flex-col">
    <!-- Kopfzeile: zurück, Zähler, schließen -->
    <div
      class="pointer-events-auto flex shrink-0 items-center justify-between gap-3 px-3 py-2.5 sm:px-6 sm:py-3"
    >
      <a
        class="label on-dark inline-flex h-9 min-w-9 shrink-0 items-center justify-center gap-2 rounded-full border border-cream/30 px-2 text-cream/75 transition-colors hover:border-cream hover:text-cream sm:border-0 sm:px-0"
        href={galleryUrl}
        data-lb-close
        aria-label={`${GALLERY.back.sl} / ${GALLERY.back.de}`}
      >
        <span aria-hidden="true" class="text-[1rem] leading-none">←</span>
        <span class="hidden sm:inline"
          >{GALLERY.back.sl} <span class="text-cream/30">/</span> {GALLERY.back.de}</span
        >
      </a>

      <div class="flex shrink-0 items-center gap-2 sm:gap-3">
        <p class="label whitespace-nowrap text-cream/70">
          {index + 1} <span class="text-cream/35">/</span> {total}
        </p>
        <a
          class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-cream/30 text-[0.875rem] text-cream/80 transition-colors hover:border-cream hover:bg-cream hover:text-wine"
          href={galleryUrl}
          data-lb-close
          aria-label="Zapri / Schließen"
        >
          <span aria-hidden="true">✕</span>
        </a>
      </div>
    </div>

    <!--
      Bühne: die Pfeile stehen links und rechts vom Bild (mobil liegen sie
      am Bildrand darüber, damit das Foto die volle Breite behält). Wischen
      über das Bild blättert ebenfalls weiter.
    -->
    <div
      class="pointer-events-none relative flex min-h-0 flex-1 touch-none select-none items-stretch justify-center gap-1 px-1 pb-3 sm:gap-5 sm:px-6 sm:pb-5"
      data-lb-stage
    >
      {
        prev && (
          <a
            class={`${arrowClass} left-1`}
            href={photoHref(prev.id)}
            hx-get={photoHref(prev.id)}
            hx-target="#lightbox-slot"
            hx-swap="innerHTML"
            hx-push-url="true"
            data-lb-prev
            aria-label="Prejšnja fotografija / Vorheriges Foto"
          >
            <span aria-hidden="true">←</span>
          </a>
        )
      }

      <div class="pointer-events-auto flex min-w-0 flex-col items-center justify-center">
        <!-- Verlinkt auf die JPEG-Fassung: Linksklick und „Grafik in neuem Tab öffnen“ liefern ein .jpg -->
        <a
          class="block max-w-full cursor-zoom-in"
          href={photoFileUrl(photo.id)}
          data-lb-photo
          draggable="false"
          target="_blank"
          rel="noopener"
          title={`${GALLERY.openTab.sl} / ${GALLERY.openTab.de} (.jpg)`}
        >
          <img
            src={mediaUrl(photo.id, 'full')}
            alt={caption || 'Arhivska fotografija / Archivfoto des Vereins Trta'}
            width={photo.width}
            height={photo.height}
            draggable="false"
            class="max-h-[calc(100svh-10.5rem)] w-auto max-w-full object-contain shadow-[0_30px_80px_-30px_rgba(0,0,0,0.8)] sm:max-h-[calc(100svh-9.5rem)]"
          />
        </a>

        <div class="mt-4 max-w-2xl text-center sm:mt-5">
          {
            photo.captionSl && (
              <p lang="sl" class="text-[0.875rem] leading-snug text-cream sm:text-[0.9375rem]">
                {photo.captionSl}
              </p>
            )
          }
          {
            photo.captionDe && (
              <p lang="de" class="mt-1 text-[0.875rem] leading-snug text-rose sm:text-[0.9375rem]">
                {photo.captionDe}
              </p>
            )
          }
          {
            !caption && (
              <p class="text-[0.8125rem] text-cream/60">
                Iz arhiva SPD Trta <span class="text-cream/30">/</span> Aus dem Archiv des Vereins Trta
              </p>
            )
          }
        </div>
      </div>

      {
        next && (
          <a
            class={`${arrowClass} right-1`}
            href={photoHref(next.id)}
            hx-get={photoHref(next.id)}
            hx-target="#lightbox-slot"
            hx-swap="innerHTML"
            hx-push-url="true"
            data-lb-next
            aria-label="Naslednja fotografija / Nächstes Foto"
          >
            <span aria-hidden="true">→</span>
          </a>
        )
      }
    </div>
  </div>
</div>
