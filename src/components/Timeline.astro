---
import { TIMELINE } from '../lib/content';
---

<ol class="grid gap-y-9 border-t border-wine/15 pt-8 sm:grid-cols-2 sm:gap-x-8 lg:grid-cols-7 lg:gap-x-5">
  {
    TIMELINE.map((entry) => (
      <li class="group relative border-t-2 border-sage pt-4">
        <span
          class="absolute -top-[5px] left-0 h-2 w-2 bg-sage"
          aria-hidden="true"
        />
        <p class="font-display text-2xl leading-none font-black tracking-[-0.02em] text-sage">
          {entry.year}
        </p>
        <p lang="sl" class="mt-2.5 text-[0.8125rem] leading-[1.45] tracking-[0.02em] text-ink">
          {entry.sl}
        </p>
        <p lang="de" class="mt-1.5 text-[0.8125rem] leading-[1.45] tracking-[0.02em] text-wine">
          {entry.de}
        </p>
      </li>
    ))
  }
</ol>
