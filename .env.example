# --- Zugang zum Redaktionsbereich (/admin) --------------------------------
# Bitte vor dem Livegang ändern!
ADMIN_PASSWORD=kumst30

# Optional: festes Secret zum Signieren des Session-Cookies.
# Ohne Angabe wird automatisch eines in data/.session-secret erzeugt.
# ADMIN_SECRET=

# --- Wo liegen Galerie und Uploads? --------------------------------------
# Standard: ./data
# DATA_DIR=/var/lib/kumst/data

# --- Adressen -------------------------------------------------------------
# Vollständige Adresse der Seite – inklusive Unterverzeichnis (canonical/OG).
SITE_URL=https://www.trta.at/30-let-kumst

# Unterverzeichnis, unter dem die Seite läuft (wie im QR-Code der Broschüre).
# Läuft die Seite auf einer eigenen Domain, hier "/" eintragen.
BASE_PATH=/30-let-kumst

# Port des Node-Servers (Standard 4321)
PORT=4321
